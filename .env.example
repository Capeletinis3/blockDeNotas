# ===========================================================
# Variables de entorno de SHESHE
# Copiá este archivo a ".env" y completá los valores reales.
# ¡NUNCA subas el archivo .env al repositorio! (ya está en .gitignore)
# ===========================================================

# Entorno: development | production
NODE_ENV=development

# Puerto del servidor
PORT=3000

# URL pública del sitio (para los back_urls y el webhook de Mercado Pago).
# En local podés dejar http://localhost:3000
# En producción usá tu dominio https://tu-dominio.com
PUBLIC_BASE_URL=http://localhost:3000

# Origen permitido para CORS. Dejalo vacío si el front se sirve desde
# el mismo servidor (recomendado). Para varios, separá con comas.
ALLOWED_ORIGIN=

# === Mercado Pago ===
# Access Token (SECRETO) de tu cuenta. Sacalo del panel de desarrolladores:
# https://www.mercadopago.com.ar/developers/panel/app
# Para probar, usá el token de PRUEBA (empieza con TEST-).
MP_ACCESS_TOKEN=

# Clave secreta del webhook (opcional pero recomendado) para validar firmas.
MP_WEBHOOK_SECRET=
